{% extends "_layouts/base" %}
{% set uri = entry.uri|default('blog') %}
{% set pageHeading = entry.pageHeading|default(entry.title) %}

{% set mainPage = craft.entries.section('hlavneStranky').id(5).one %}

{% set showSidebar = true %}

{% block pageLayout %}
  {% embed '_layouts/page/default' %}
    {% block subNavMobile %}
      
    {% endblock %}
    {% block contentLayout %}
      {% embed '_layouts/content/default' %}

        {% block mainContent %}
          {% cache %}
            <h1 class="main-heading">{{ pageHeading }}</h1>
            <div class="default-content">
              {% include '_partials/contentBuilder' with {contentField: entry.mainContent, blocksDir: 'mainContent'} %}
            </div>
          {% endcache %}
        {% endblock %}

        {% set parent = craft.entries.section('pages').type('zoznamVyziev').kategoria(entry.kategoria).one %}
        {% set subpages = craft.entries.section('vyzvy').kategoria(entry.kategoria) %}
        {% block subNav %}
          {% if subpages is defined and subpages | length %}
            <div class="sub-nav hidden-xs">
              <h2 class="px-4 py-3 text-xl font-bold text-white bg-brand-three ">{{ parent.title }}</h2>
              <ul class="p-4 pb-10">
                {% nav subpage in subpages.all %}
                  <li>
                    <a class="block py-1.5 -mx-4 px-4 text-lg font-bold hover:bg-brand-one/20 hover:text-brand-three {{ subpage.uri == uri ? 'bg-brand-one/20' : 'bg-white' }}" href="{{ subpage.url }}">{{ subpage.title }}</a>
                  </li>
                {% endnav %}
              </ul>
            </div>
          {% endif %}
        {% endblock %}
      {% endembed %}
    {% endblock %}
  {% endembed %}
{% endblock %}
